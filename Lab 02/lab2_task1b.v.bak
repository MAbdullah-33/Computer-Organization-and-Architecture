module fulladder(a,b,c,sum,carry);
input a,b,c;
output sum,carry;
assign sum = a^b^c;
assign carry = (a&b)+(a&c)+(b^c);
endmodule


module testbench_fulladder();

reg a,b,c;
wire sum,carry;

fulladder uut(.a(a), .b(b), .c(c), .sum(sum), .carry(carry));

initial
begin

    a = 0 ; b = 0 ; c = 0;
#50 a = 0 ; b = 0 ; c = 1;
#50 a = 0 ; b = 1 ; c = 0;
#50 a = 0 ; b = 1 ; c = 1;
#50 a = 1 ; b = 0 ; c = 0;
#50 a = 1 ; b = 0 ; c = 1;
#50 a = 1 ; b = 1 ; c = 0;
#50 a = 1 ; b = 1 ; c = 1;
#50; 

$stop;

end
endmodule 
